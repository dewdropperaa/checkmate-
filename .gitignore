# Environment files with secrets
.env
backend/.env

# Firebase Admin service-account keys (never commit)
*-firebase-adminsdk-*.json
backend/secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / extension
node_modules/
extension/dist/

# Checkpoint database (sqlite)
backend/data/
backend/reports/

# Local scanner binaries (install via scripts/install_tools.sh)
backend/tools-bin/*
!backend/tools-bin/.gitkeep
backend/tools-bin/testssl-repo/

# OS
.DS_Store
Thumbs.db

# Vercel CLI local link
.vercel

# Terraform
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
**/crash.log
**/override.tf
**/*_override.tf
terraform/cloudflare/origin-lock/*.crt
terraform/cloudflare/origin-lock/*.key
terraform/cloudflare/origin-lock/*.pem
