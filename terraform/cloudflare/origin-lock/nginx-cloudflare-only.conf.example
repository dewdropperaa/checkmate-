# Cloudflare origin lock — nginx example
#
# Goals:
#   1. Terminate TLS with Cloudflare Origin CA (Full strict).
#   2. Allow only Cloudflare published IP ranges to reach :443 (and ideally
#      close :8000 to the public internet entirely — Compose bind to private
#      interface or firewall drop).
#   3. Optional: require Authenticated Origin Pulls client certificate.
#
# Install Origin CA materials from Terraform outputs:
#   terraform output -raw origin_ca_certificate_pem > /etc/ssl/checkmate/origin.crt
#   terraform output -raw origin_ca_private_key_pem > /etc/ssl/checkmate/origin.key
#   chmod 600 /etc/ssl/checkmate/origin.key
#
# Fetch current Cloudflare IPs (re-run on a schedule — ranges change):
#   https://www.cloudflare.com/ips/
#   https://api.cloudflare.com/client/v4/ips
#
# Download AOP CA (when enable_authenticated_origin_pulls=true):
#   https://developers.cloudflare.com/ssl/origin-configuration/authenticated-origin-pull/#zone-level--cloudflare-cert

geo $cf_connecting {
  default       0;
  # Paste IPv4 + IPv6 CIDRs from https://www.cloudflare.com/ips/ below.
  # Example placeholders — REPLACE with live list before production:
  173.245.48.0/20 1;
  103.21.244.0/22 1;
  103.22.200.0/22 1;
  103.31.4.0/22   1;
  141.101.64.0/18 1;
  108.162.192.0/18 1;
  190.93.240.0/20 1;
  188.114.96.0/20 1;
  197.234.240.0/22 1;
  198.41.128.0/17 1;
  162.158.0.0/15  1;
  104.16.0.0/13   1;
  104.24.0.0/14   1;
  172.64.0.0/13   1;
  131.0.72.0/22   1;
}

server {
  listen 443 ssl http2;
  server_name api.checkmate.ma; # match your api hostname

  ssl_certificate     /etc/ssl/checkmate/origin.crt;
  ssl_certificate_key /etc/ssl/checkmate/origin.key;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # Reject non-Cloudflare source IPs at the HTTP layer (defense in depth;
  # prefer host firewall / security group allowlist as the primary control).
  if ($cf_connecting = 0) {
    return 403;
  }

  # Uncomment when Authenticated Origin Pulls is enabled in Terraform:
  # ssl_client_certificate /etc/ssl/checkmate/cloudflare-aop-ca.pem;
  # ssl_verify_client on;

  location / {
    proxy_pass         http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Forwarded-Proto $scheme;
    # Real client IP for app rate limits (optional follow-up: teach FastAPI
    # to trust CF-Connecting-IP only when remote_addr is a Cloudflare IP).
    proxy_set_header   CF-Connecting-IP  $http_cf_connecting_ip;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
  }
}

# Do NOT expose uvicorn :8000 publicly once this proxy is in place.
