# APP_ENV=hosted — cloud API (Render/Fly) + Vercel web. Copy to Render env vars / .env on server.
# See docs/LAUNCH_NO_DOCKER.md

APP_NAME=checkmate
APP_ENV=hosted
DEBUG=false
LOG_LEVEL=INFO

PUBLIC_APP_URL=https://checkmateapp-nine.vercel.app

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
REQUIRE_FIREBASE_AUTH=true

CREDENTIALS_MASTER_KEY=

CLOUD_SCANNING_ENABLED=false

ZAP_API_KEY=

REQUIRE_TOOLCHAIN_AT_STARTUP=false
FIRECRAWL_ENABLED=false

DODO_ENVIRONMENT=test

AUTHORIZED_TARGETS=

GEMINI_API_KEY=
GROQ_API_KEY=
