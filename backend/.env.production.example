# =============================================================================
# checkmate API — PRODUCTION template (copy to .env on the server only)
#   cp .env.production.example .env
# Never commit .env or service-account JSON.
#
# APP_ENV=production enables strict startup checks (backend/core/config.py).
# For a billing-free staging cutover, use APP_ENV=staging + test Dodo keys and a
# non-production Firebase project instead.
# =============================================================================

APP_NAME=checkmate
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Legal scan scope — comma-separated domains/URLs you are authorized to test.
AUTHORIZED_TARGETS=

# --- Public web origin (password reset links, emails, CORS context) ---
PUBLIC_APP_URL=https://checkmateapp-nine.vercel.app

# --- Firebase Admin (server only) ---
FIREBASE_PROJECT_ID=
PRODUCTION_FIREBASE_PROJECT_ID=
# On the server, prefer a path outside the git tree:
# FIREBASE_CREDENTIALS_PATH=/etc/checkmate/firebase-sa.json
FIREBASE_CREDENTIALS_PATH=
# Or single-line JSON (secret manager / Docker secret):
# FIREBASE_CREDENTIALS_JSON=
REQUIRE_FIREBASE_AUTH=true

# --- Encryption for stored site login credentials ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_MASTER_KEY=

# --- OWASP ZAP (Compose sets ZAP_API_URL=http://zap:8080) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ZAP_API_KEY=
ZAP_MAX_CONCURRENT=1

# --- Toolchain (true in Docker Compose production) ---
REQUIRE_TOOLCHAIN_AT_STARTUP=true
TOOL_RETRY_ATTEMPTS=3
TOOL_RETRY_BACKOFF_SECONDS=2.0

# --- Scan limits (tune for host size) ---
SCAN_RATE_LIMIT_WINDOW_SECONDS=60
SCAN_RATE_LIMIT_MAX_REQUESTS=10
SCAN_RATE_LIMIT_MAX_CONCURRENT_PER_CLIENT=1
SCAN_RATE_LIMIT_MAX_CONCURRENT_GLOBAL=3
VERIFY_FIX_COOLDOWN_SECONDS=180
SCAN_TIMEOUT_SECONDS=1800
REPORT_MAX_FINDINGS=500

# --- LLM (optional; set keys you use) ---
AI_LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Firecrawl: set key OR disable for a slimmer launch ---
FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=

# --- Dodo Payments (required when APP_ENV=production) ---
DODO_ENVIRONMENT=live
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# --- Watch / email (optional at launch) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Checkmate <noreply@yourdomain.com>
NVD_API_KEY=
WATCH_SCHEDULER_ENABLED=true

# --- Founder override (optional) ---
CREATOR_EMAILS=

# =============================================================================
# STAGING alternative (APP_ENV=staging): DEBUG=false, DODO_ENVIRONMENT=test,
# DODO_API_KEY=dodo_test_*, DODO_WEBHOOK_SECRET required, separate Firebase
# project (must NOT match PRODUCTION_FIREBASE_PROJECT_ID).
# =============================================================================
