# Application
APP_NAME=checkmate
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated allowlist of authorized scan targets (domains or URLs).
# Example: example.com,https://staging.example.com
AUTHORIZED_TARGETS=

# LLM provider keys (set only what you use; never commit real values)
# AI Security Copilot (ai_synthesis) uses Gemini first, then Groq, by default.
# When no key is set for any configured provider the stage is skipped cleanly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_LLM_PROVIDERS=gemini,groq
AI_SYNTHESIS_TIMEOUT_SECONDS=15
AI_SYNTHESIS_MAX_LLM_CALLS=2
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Firecrawl API key for enhanced recon URL discovery (https://firecrawl.dev)
# Leave empty to disable Firecrawl-powered recon (Katana still runs).
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true
FIRECRAWL_MAP_LIMIT=500
FIRECRAWL_INCLUDE_SUBDOMAINS=true
FIRECRAWL_SITEMAP=include
FIRECRAWL_SCRAPE_ROOT=true
FIRECRAWL_TIMEOUT=120
# Finding verification: corroborate content-based findings against scraped
# page content to reduce false positives (never deletes findings).
FIRECRAWL_VERIFY_FINDINGS=true
FIRECRAWL_VERIFY_MAX_URLS=15
FIRECRAWL_VERIFY_TIMEOUT=60

# OWASP ZAP daemon API key (required when api.disablekey=false)
ZAP_API_KEY=
# Local uvicorn: http://localhost:8080 (start ZAP via docker compose up zap).
# Docker Compose overrides this to http://zap:8080.
ZAP_API_URL=http://localhost:8080

# /scan API safety limits
SCAN_RATE_LIMIT_WINDOW_SECONDS=60
SCAN_RATE_LIMIT_MAX_REQUESTS=10
SCAN_RATE_LIMIT_MAX_CONCURRENT_PER_CLIENT=2
SCAN_RATE_LIMIT_MAX_CONCURRENT_GLOBAL=20
SCAN_TIMEOUT_SECONDS=1800
REPORT_MAX_FINDINGS=500

# Firebase Admin (server-side only — NEVER put these in NEXT_PUBLIC_* / the web app)
# Project ID matches the web client config; credentials are the service-account secret.
FIREBASE_PROJECT_ID=
# Prefer one of:
#   FIREBASE_CREDENTIALS_PATH=./secrets/your-service-account.json
#   FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# Never commit the service-account JSON (see root .gitignore).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
# When true, /scan and scan sub-routes require a verified Firebase ID token
# (leave false while the Chrome extension still uses X-API-Key).
REQUIRE_FIREBASE_AUTH=false

# Tool reliability — refuse startup/scans when binaries/ZAP are missing.
# Use false for local uvicorn without installed CLI tools; true in Docker Compose.
REQUIRE_TOOLCHAIN_AT_STARTUP=false
TOOL_RETRY_ATTEMPTS=3
TOOL_RETRY_BACKOFF_SECONDS=2.0

# Watch Agent (scheduled background monitoring)
# Resend free tier: 3,000 emails/month, 100/day — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Checkmate <onboarding@resend.dev>
# Optional NVD key raises rate limit from 5 req/30s to 50 req/30s.
# Request at https://nvd.nist.gov/developers/request-an-api-key — works without a key.
NVD_API_KEY=
PUBLIC_APP_URL=http://localhost:3000
# Shared secret for Dodo Payments webhooks that sync plan changes.
DODO_WEBHOOK_SECRET=
WATCH_SCHEDULER_ENABLED=true
