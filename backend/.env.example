# Application
APP_NAME=sentinel-scan
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated allowlist of authorized scan targets (domains or URLs).
# Example: example.com,https://staging.example.com
AUTHORIZED_TARGETS=

# LLM provider keys (set only what you use; never commit real values)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Firecrawl API key for enhanced recon URL discovery (https://firecrawl.dev)
# Leave empty to disable Firecrawl-powered recon (Katana still runs).
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true
FIRECRAWL_MAP_LIMIT=500
FIRECRAWL_INCLUDE_SUBDOMAINS=true
FIRECRAWL_SITEMAP=include
FIRECRAWL_SCRAPE_ROOT=true
FIRECRAWL_TIMEOUT=120
# Finding verification: corroborate content-based findings against scraped
# page content to reduce false positives (never deletes findings).
FIRECRAWL_VERIFY_FINDINGS=true
FIRECRAWL_VERIFY_MAX_URLS=15
FIRECRAWL_VERIFY_TIMEOUT=60

# OWASP ZAP daemon API key (required when api.disablekey=false)
ZAP_API_KEY=

# /scan API safety limits
SCAN_RATE_LIMIT_WINDOW_SECONDS=60
SCAN_RATE_LIMIT_MAX_REQUESTS=10
SCAN_RATE_LIMIT_MAX_CONCURRENT_PER_CLIENT=2
SCAN_RATE_LIMIT_MAX_CONCURRENT_GLOBAL=20
