{
  "manifest_version": 3,
  "name": "checkmate",
  "version": "0.1.2",
  "description": "Authorized web vulnerability scanning from the browser.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "https://localhost:3000/*",
      "https://checkmate.ma/*",
      "https://*.checkmate.ma/*"
    ]
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "checkmate",
    "default_icon": "logo.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
