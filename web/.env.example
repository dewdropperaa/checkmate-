# Firebase web client config (safe to expose in the browser — protected by
# Firebase Auth domain restrictions / App Check / Security Rules, NOT by secrecy).
# Never put Admin SDK private keys or service-account JSON in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Analytics measurement ID (client-safe)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# checkmate FastAPI backend (used for /auth/sync after sign-in).
# Prefer 127.0.0.1 over localhost — on Windows, browsers often resolve
# localhost to ::1 first while uvicorn listens on 127.0.0.1 only.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Vercel / production (server-only — not exposed to the browser bundle):
# When set, the Next.js app proxies browser API calls to this origin at
# /api/backend/* so you do not have to point NEXT_PUBLIC_* at loopback.
# Example: API_BASE_URL=https://api.yourdomain.com
# API_BASE_URL=
