# =============================================================================
# checkmate web — Vercel PRODUCTION (checkmate.app)
#
# Set these in: Vercel → dewdropperaas-projects / checkmate.app → Settings →
# Environment Variables → Production
#
# After any change to NEXT_PUBLIC_* or API_BASE_URL, trigger a production redeploy.
# Do not commit real values. Copy names only.
# =============================================================================

# Firebase web client (Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# FastAPI origin — use your public API hostname (NOT 127.0.0.1 or tunnels).
NEXT_PUBLIC_API_BASE_URL=https://api.checkmate.ma

# Optional: server-only proxy target (same HTTPS origin as above).
# Browser calls /api/backend/* on the Vercel host when loopback NEXT_PUBLIC is
# mis-set. Prefer setting NEXT_PUBLIC_API_BASE_URL directly unless you need
# same-origin API calls only.
# API_BASE_URL=https://api.checkmate.ma

# =============================================================================
# Remove before launch if still present from debugging:
#   http://127.0.0.1:8000
#   https://*.loca.lt
# =============================================================================
